# Used by docker-compose.yml. Copy to `.env` and change the passwords.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me
# Folder with your music (mounted read-only into the container and scanned in place)
MUSIC_DIR=~/Music
# 127.0.0.1 = only this computer. 0.0.0.0 = the whole network (Chorus has no login!)
CHORUS_BIND=127.0.0.1
CHORUS_PORT=8000
