# Copy to /etc/chorus/chorus.env and restart the service: sudo systemctl restart chorus

# Listen address. 127.0.0.1 = this machine only (put a reverse proxy with a login in front of it).
# 0.0.0.0 = every device that can reach the server. Chorus has NO login of its own.
CHORUS_HOST=127.0.0.1
CHORUS_PORT=8000

# Folders Chorus may scan for music (comma-separated). The service runs as a throw-away user with read-only
# access to /home, so keep the music somewhere readable, e.g. /srv/music.
# LIBRARY_DIRS=/srv/music

# Use MySQL instead of the built-in SQLite database:
# DATABASE_URL=mysql+pymysql://chorus:password@127.0.0.1/chorus?charset=utf8mb4
